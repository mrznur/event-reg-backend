# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=generate-a-long-random-secret
TICKET_SECRET=generate-a-different-long-random-secret

# ── Cloudinary ────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── Mail (Gmail SMTP) ─────────────────────────────────────────────────────────
MAIL_FROM=your-email@gmail.com
MAIL_USER=your-email@gmail.com
MAIL_APP_PASSWORD=your-16-char-app-password

# ── URLs ──────────────────────────────────────────────────────────────────────
# Frontend origin — used in QR codes, email links, and CORS
FRONTEND_URL=https://your-frontend-domain.com

# Comma-separated allowed CORS origins
CORS_ORIGIN=https://your-frontend-domain.com

# Base URL for terminal scripts
API_BASE_URL=http://localhost:4000/api

# ── Contact form ──────────────────────────────────────────────────────────────
CONTACT_EMAIL=info@bucc.club

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@bucc.club
ADMIN_PASSWORD=set-a-strong-password

# Secret admin login path — POST /api/<this value>
# Change to something only you know. Never share or document it.
ADMIN_LOGIN_PATH=change-this-to-something-secret
